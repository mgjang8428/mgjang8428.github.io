---
import BaseHead from "@/layouts/default/BaseHead.astro";

import RootLayout from "@/layouts/RootLayout.astro";

import Header from "@/layouts/default/Header.astro";
import MainLayout from "@/layouts/default/MainLayout.astro";
import AboutContents from "@/layouts/contents/AboutContents.astro";
import Footer from "@/layouts/default/Footer.astro";

const { title, description } = Astro.props;
---

<RootLayout>
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <MainLayout>
      <div
        class="sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto basis-1/5 hidden 2xl:block"
      >
      </div>
      <div class="basis-3/5 max-w-5xl">
        <AboutContents {...Astro.props}>
          <slot />
        </AboutContents>
      </div>
      <div
        class="sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto basis-1/5 hidden 2xl:block"
      >
      </div>
    </MainLayout>
    <Footer />
  </body>
</RootLayout>
